    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "How do I choose the right model for me?",
            "text": "<p>If you are unsure which model to choose, feel free to contact our support team for recommendations. Our collection includes glasses for indoor and outdoor use, as well as unisex models.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "How does Fullerene C60 technology work?",
            "text": "<p>Fullerene C60 is a nanomaterial that acts as a quantum light generator, restructuring light wavelengths to be compatible with human biostructures, thereby optimizing eye and brain function.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "Are Hyperlight Optics® glasses suitable for indoor and outdoor use?",
            "text": "<p>Yes, we offer models specifically designed for indoor, outdoor, or combined use.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "Do these glasses block blue light?",
            "text": "<p>Yes, Hyperlight Optics® glasses effectively block harmful blue light (&lt;450 nm) and reduce eye fatigue caused by prolonged screen exposure.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "title": "Who can use Hyperlight Optics® glasses?",
            "text": "<p>The glasses are suitable for everyone—students, professionals, athletes, parents, and children. They are especially beneficial for individuals who spend a lot of time in front of screens or are exposed to artificial light and UV radiation.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Didn’t find your answer?",
            "text": "<p>Don't hestitate to contact us</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
