esonant. Through the eye, this improved light signal communicates with the brain and supports the body’s natural regulatory systems. By supporting the hypothalamus, the central regulator of many vital processes, Hyperlight Optics®️ helps the body maintain balance, clarity and resilience. Better light means better signals. Better signals mean better function.","heading_size":"title-sm","heading_alignment":"text-left","heading_tag":"h2","button_label":"","button_link":"","button_external":false,"button_icon":true,"color_text":"","color_button_text":"","color_button_background":"","color_button_gradient":""}},"video-with-text-overlay":{"type":"video-with-text-overlay","custom_css":[],"settings":{"transparent_header":false,"video":"shopify:\/\/files\/videos\/1stAnimation.mp4","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","cover_image":"shopify:\/\/shop_images\/1stAnimation_copy.jpg","description":"","enable_video_autoplay":true,"enable_video_looping":false,"image_height":"adapt","content_width":"medium","content_position":"md:items-center md:justify-center","text_alignment":"center","video_mobile":"shopify:\/\/files\/videos\/mob_appFinal.mp4","video_url_mobile":"","image_height_mobile":"500px","content_position_mobile":"items-start justify-center","text_alignment_mobile":"center","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#000000","overlay_opacity":0,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":true}},"shop-the-look":{"type":"shop-the-look","blocks":{"product_n7iHJL":{"type":"product","disabled":true,"settings":{"product":"bogota-havana","color_text":"#ffffff","vertical":40,"horizontal":45,"vertical_mobile":50,"horizontal_mobile":50}},"product-3":{"type":"product","settings":{"product":"rio-havana","color_text":"#ffffff","vertical":38,"horizontal":73,"vertical_mobile":50,"horizontal