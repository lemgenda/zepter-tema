
{%- capture direction -%}{% render 'direction' %}{%- endcapture -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ direction | strip }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_button_background }}">

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  {% # theme-check-disable RemoteAsset %}
  <link rel="dns-prefetch" href="https://ajax.googleapis.com">
  <link rel="dns-prefetch" href="https://maps.googleapis.com">
  <link rel="dns-prefetch" href="https://maps.gstatic.com">
  {% # theme-check-enable RemoteAsset %}

  {%- if settings.favicon != blank -%}
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
  {%- endif -%}

  <!-- BEAE-GLOBAL-FONT -->
  {% capture the_snippet_global_font %}{% include 'beae-global-font' %}{% endcapture %}
  {% unless the_snippet_global_font contains 'Liquid error' %}
    {{ the_snippet_global_font }}
  {% endunless %}
  <!-- END BEAE-GLOBAL-FONT -->

  <!-- BEAE-HEADER -->
  {%- render 'beae_header' -%}
  <!-- END BEAE-HEADER -->

  <title>
    {{- page_title -}}
    {%- if current_tags -%}
      {%- assign meta_tags = current_tags | join: ', ' -%}
      &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}
    {%- endif -%}
    {%- if current_page != 1 -%}
      &ndash; {{ 'general.meta.page' | t: page: current_page }}
    {%- endif -%}
    {%- if template == 'password' -%}
      {{- shop.name -}}
    {%- else -%}
      {%- unless page_title contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- liquid
    render 'social-meta-tags'
    render 'css-variables'

    echo 'theme.css' | asset_url | stylesheet_tag: preload: true
    echo 'accessibility.css' | asset_url | stylesheet_tag

    if direction == 'rtl'
      echo 'rtl.css' | asset_url | stylesheet_tag: preload: true
    endif
  -%}

  <link
    rel="stylesheet"
    href="{{ 'apps.css' | asset_url }}"
    media="print"
    fetchpriority="low"
    onload="this.media='all'"
  >

  <noscript>
    {{ 'apps.css' | asset_url | stylesheet_tag }}
  </noscript>

  {{ content_for_header }}

  <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'accessibility.js' | asset_url }}" defer="defer"></script>

  {%- if request.page_type contains 'customers/' -%}
    <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- render 'js-variables' -%}
</head>

<body
  class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}{% if request.path == '/challenge' %} template-challange{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}"
  data-rounded-button="{{ settings.rounded_button }}"
  data-rounded-input="{{ settings.rounded_input }}"
  data-rounded-block="{{ settings.rounded_block }}"
  data-rounded-card="{{ settings.rounded_card }}"
  data-button-hover="{{ settings.buttons_hover }}"
  data-a11y-cart-added="{{ 'general.accessibility.cart_added_announcement' | t | escape }}"
  data-a11y-cart-error="{{ 'general.accessibility.cart_error_announcement' | t | escape }}"
  data-a11y-cart-updated="{{ 'general.accessibility.cart_updated_announcement' | t | escape }}"
  {% if settings.enable_lazy_image %}data-lazy-image{% endif %}
  data-title-animation
  data-page-rendering
>
  {%- liquid
    if settings.enable_page_transition
      render 'loading-bar'
    endif

    render 'mouse-cursor'

    echo '<header class="site-header-landmark" role="banner">'
    echo '<nav class="skip-links" aria-label="Skip navigation"><a class="sr-only skip-link" href="#MainContent">'
    echo 'general.accessibility.skip_to_content' | t
    echo '</a></nav>'
    sections 'header-group'
    echo '</header>'
    sections 'overlay-group'
  -%}

  <div class="page-container" id="PageContainer">
    <main class="main-content relative" id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="footer-group block w-full">
      {%- sections 'footer-group' -%}
    </footer>
  </div>

  <!--
    Accessibility live regions.
    Keep these elements in the DOM and do not add hidden, display:none,
    visibility:hidden or aria-hidden="true".
  -->
  <div
    id="a11y-announcer"
    class="a11y-announcer"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <div
    id="a11y-alert"
    class="a11y-announcer"
    role="alert"
    aria-atomic="true"
  ></div>

  <ul hidden>
    <li id="a11y-refresh-page-message">
      {{ 'general.accessibility.refresh_page' | t }}
    </li>
    <li id="a11y-new-window-message">
      {{ 'general.accessibility.link_messages.new_window' | t }}
    </li>
  </ul>

  {%- if request.design_mode == false -%}
    <script
      src="{{ 'instant-page.js' | asset_url }}"
      type="module"
      fetchpriority="low"
      defer="defer"
    ></script>
  {%- endif -%}

  <!-- BEAE-FOOTER -->
  {%- render 'beae_footer' -%}
  <!-- END BEAE-FOOTER -->

  <!-- BEAE-AB-SNIPPET -->
  {%- render 'beae_ab_snippet' -%}
  <!-- END BEAE-AB-SNIPPET -->

  <!-- Auglio -->
  <script src="https://m.auglio.com/c30b0804a538811ae2837b14bcb83a2f" async></script>

  <!-- Zepter return link -->
  <script>
    (function () {
      'use strict';

      var params = new URLSearchParams(window.location.search);
      var isFromZepter = params.get('ref') === 'zepter';

      if (!isFromZepter) {
        return;
      }

      var requestedReturnUrl = params.get('return');
      var fallbackUrl = 'https://www.zepter.com';
      var returnUrl = fallbackUrl;

      /*
       * Only allow HTTPS destinations on the Zepter domain.
       * This prevents the return parameter from becoming an open redirect.
       */
      if (requestedReturnUrl) {
        try {
          var parsedReturnUrl = new URL(requestedReturnUrl, window.location.origin);

          if (
            parsedReturnUrl.protocol === 'https:' &&
            (
              parsedReturnUrl.hostname === 'zepter.com' ||
              parsedReturnUrl.hostname.endsWith('.zepter.com')
            )
          ) {
            returnUrl = parsedReturnUrl.href;
          }
        } catch (error) {
          returnUrl = fallbackUrl;
        }
      }

      var button = document.createElement('a');
      button.href = returnUrl;
      button.textContent = '← Back to Zepter';
      button.setAttribute('aria-label', 'Back to Zepter website');

      button.style.position = 'fixed';
      button.style.top = '20px';
      button.style.right = '20px';
      button.style.zIndex = '999999999';
      button.style.background = '#ffffff';
      button.style.color = '#000000';
      button.style.padding = '12px 18px';
      button.style.border = '1px solid #333333';
      button.style.borderRadius = '999px';
      button.style.fontSize = '14px';
      button.style.fontWeight = '600';
      button.style.textDecoration = 'none';

      button.addEventListener('focus', function () {
        button.style.outline = '3px solid #155eef';
        button.style.outlineOffset = '3px';
      });

      button.addEventListener('blur', function () {
        button.style.outline = '';
        button.style.outlineOffset = '';
      });

      document.body.appendChild(button);
    })();
  </script>
</body>
</html>